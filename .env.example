APP_ENV=development
LOG_LEVEL=INFO

# Same Postgres instance the existing Node/Prisma app already uses (see the JS reference repo's
# prisma/schema.prisma) -- SQLAlchemy + asyncpg, no schema changes in the initial migration.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dua_scent_db

OPENAI_API_KEY=
# No default on purpose -- must be set per environment, never hardcoded in code.
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT_SECONDS=30
# Note-aware customer-facing copy generation's own model -- kept as a separate env-overridable
# setting from OPENAI_MODEL rather than collapsed into it, so the two can diverge again later if
# needed. Currently set to match OPENAI_MODEL for staging.
OPENAI_COPY_MODEL=gpt-5.6-terra
OPENAI_COPY_TEMPERATURE=0.5

# Odoo inventory REST API (bearer-token auth against one specific URL -- this integration does
# NOT use a direct XML-RPC odoo_url/database/username/password connection).
# REQUIRED to enable the integration; there is NO built-in default (Phase 5A). Left empty, no
# request is ever made, recommendations show availability as unconfirmed, and commerce is blocked.
# Must be https. Example shape only: https://<your-odoo-host>/api/get-inventory
ODOO_PING_URL=
ODOO_INVENTORY_URL=
ODOO_INVENTORY_API_KEY=
ODOO_INVENTORY_CACHE_TTL_SECONDS=60

# Salted HMAC salt for OrderHistory.customerKeyHash -- never commit the real value.
CUSTOMER_KEY_HASH_SALT=

# Shared secret the Node Shopify adapter sends as `X-Internal-Api-Key` on every call to this
# service. Must match exactly on both sides. Leave unset only for local dev without Node in the
# loop -- the check is skipped entirely when this is empty.
INTERNAL_API_KEY=

# Comma-separated browser origins allowed to call this API directly. The storefront widget's own
# /chat calls (Phase 6) don't need this -- CORS only applies to browser-initiated cross-origin
# fetches, and a same-origin App Proxy request from Shopify's edge isn't one either. Leave empty
# unless something genuinely calls this API from a browser on a different origin.
ALLOWED_ORIGINS=

# Real names from the JS reference app's shopify.server.js / shopify.app.toml -- used for webhook
# HMAC verification, App Proxy signature verification, and Admin GraphQL calls. Merchant OAuth
# itself (the /auth install flow) is still Node-owned; Python only reads the Session row that
# flow already produced -- see app/shopify/sessions.py and the migration audit.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# The one installed store, e.g. your-store.myshopify.com. Required: every Shopify Admin call is
# refused until this is set, and no request header or body can ever choose a different shop.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,write_inventory,read_publications,write_publications,unauthenticated_read_product_listings,write_app_proxy
SHOPIFY_API_VERSION=2025-04

# ---- Phase 2: public chat trust boundary and abuse controls ----
# Trusted reverse-proxy hops in front of this service (Render edge = 1; local = 0). With 0 the
# X-Forwarded-For header is ignored entirely.
TRUSTED_PROXY_HOPS=0
# Keyed hash for abuse identifiers (IP addresses are never stored raw). Any long random string.
ABUSE_IDENTITY_HASH_KEY=
# Input and cost limits (defaults shown; see app/config.py for the full list).
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_CONTEXT_MAX_MESSAGES=40
CHAT_CONTEXT_MAX_CHARS=24000
CHAT_MAX_TOOL_TURNS=10
CHAT_MAX_CONCURRENT_TURNS=8
OPENAI_MAX_OUTPUT_TOKENS=700
# Rate limits as "<count>/<window seconds>", stored in PostgreSQL (multi-instance safe).
RATE_LIMIT_CONVERSATION_CREATE_PER_IP=10/3600
RATE_LIMIT_CHAT_TURN_PER_CONVERSATION=12/60
RATE_LIMIT_CHAT_TURN_PER_CONVERSATION_DAILY=200/86400
RATE_LIMIT_CHAT_TURN_PER_IP=30/60
# Phase 4 scope/security gate (docs/AI_SECURITY_GATE.md). The semantic classifier is one bounded,
# low-privilege structured call used only when the deterministic layer is uncertain; off means
# uncertain messages are UNRESOLVED: the customer is invited to restate and nothing else runs
# (fail closed, Phase 4A).
SECURITY_GATE_SEMANTIC_ENABLED=true
SECURITY_GATE_CLASSIFIER_TIMEOUT_SECONDS=8
# Temporary throttle after repeated attack-classified messages (conversation / source address).
RATE_LIMIT_SECURITY_DENIED_PER_CONVERSATION=15/3600
RATE_LIMIT_SECURITY_DENIED_PER_IP=40/3600
# Phase 5A: the inventory SOURCE CONTRACT. Operator-declared facts, no defaults, none is a bypass.
# Commerce (save / re-price / add to cart) stays blocked until all three are set truthfully AND the
# endpoint's response carries matching evidence. See docs/INVENTORY_COMMERCE_SECURITY.md section 2a.
#   The stock location the endpoint reports for, exactly as it echoes it in its "location" field.
ODOO_INVENTORY_LOCATION_SCOPE=
#   UNRESERVED_AVAILABLE (rows carry "available_qty" = on hand minus reservations) satisfies the
#   policy. ON_HAND_INCLUDES_RESERVED is the truthful value for an endpoint that only reports
#   "on_hand_qty", and does NOT satisfy it.
ODOO_INVENTORY_QUANTITY_SEMANTICS=
#   The most fragrance oil (ml) one finished bottle can draw from inventory in total, including
#   loss and overfill, for every supported build. Must be between 14 and 34.
MANUFACTURING_MAX_OIL_ML_PER_BOTTLE=
# Phase 5 (F9): how long a positive commerce inventory check may authorize a write. Commerce never
# uses the recommendation cache. There is deliberately no switch that lets unknown or unavailable
# inventory authorize a commerce write. Commerce also requires OdooOilMapping.unitOfMeasure = ml
# on every component mapping (docs/INVENTORY_COMMERCE_SECURITY.md sections 2a and 10).
COMMERCE_INVENTORY_MAX_AGE_SECONDS=30
