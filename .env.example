APP_ENV=development
LOG_LEVEL=INFO

# Same Postgres instance the existing Node/Prisma app already uses (see the JS reference repo's
# prisma/schema.prisma) -- SQLAlchemy + asyncpg, no schema changes in the initial migration.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dua_scent_db

OPENAI_API_KEY=
# No default on purpose -- must be set per environment, never hardcoded in code.
OPENAI_MODEL=
OPENAI_TEMPERATURE=0.3
OPENAI_TIMEOUT_SECONDS=30
# Note-aware customer-facing copy generation's own model -- kept as a separate env-overridable
# setting from OPENAI_MODEL rather than collapsed into it, so the two can diverge again later if
# needed. Currently set to match OPENAI_MODEL for staging.
OPENAI_COPY_MODEL=gpt-5.6-terra
OPENAI_COPY_TEMPERATURE=0.5

# Odoo inventory REST API (bearer-token auth against one specific URL -- this integration does
# NOT use a direct XML-RPC odoo_url/database/username/password connection).
ODOO_PING_URL=https://your-odoo-instance.example.com/api/v1/dua-ai/ping
ODOO_INVENTORY_URL=https://your-odoo-instance.example.com/api/get-inventory
ODOO_INVENTORY_API_KEY=
ODOO_INVENTORY_CACHE_TTL_SECONDS=60

# Salted HMAC salt for OrderHistory.customerKeyHash -- never commit the real value.
CUSTOMER_KEY_HASH_SALT=

# Shared secret the Node Shopify adapter sends as `X-Internal-Api-Key` on every call to this
# service. Must match exactly on both sides. Leave unset only for local dev without Node in the
# loop -- the check is skipped entirely when this is empty.
INTERNAL_API_KEY=

# Comma-separated browser origins allowed to call this API directly. The storefront widget's own
# /chat calls (Phase 6) don't need this -- CORS only applies to browser-initiated cross-origin
# fetches, and a same-origin App Proxy request from Shopify's edge isn't one either. Leave empty
# unless something genuinely calls this API from a browser on a different origin.
ALLOWED_ORIGINS=

# Real names from the JS reference app's shopify.server.js / shopify.app.toml -- used for webhook
# HMAC verification, App Proxy signature verification, and Admin GraphQL calls. Merchant OAuth
# itself (the /auth install flow) is still Node-owned; Python only reads the Session row that
# flow already produced -- see app/shopify/sessions.py and the migration audit.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,write_inventory,read_publications,write_publications,unauthenticated_read_product_listings,write_app_proxy
SHOPIFY_API_VERSION=2025-04
